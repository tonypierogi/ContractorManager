# Copy to .env and fill in from Supabase dashboard → Project Settings → API.
# EXPO_PUBLIC_ vars are inlined into the client bundle at build time (public by design).
# After changing values, restart Metro with: npx expo start -c
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Where share/index.html is hosted, e.g. https://timetrack-share.expo.app/
# Unset is fine: links then go through the share-task-list edge function, which
# redirects to the same page. See share/README.md.
EXPO_PUBLIC_SHARE_PAGE_URL=
